set -e
export HOOK_STAGE=push

echo "──────────── pre-push ────────────"

# Git feeds this hook one line per ref being pushed:
#   <local_ref> <local_oid> <remote_ref> <remote_oid>
# Consume it here, once, up front — the scripts below run as children and would
# otherwise contend for the same stdin. Ranges are space-separated in
# PUSH_RANGES; scripts/lib.sh reads it. Empty (hook run by hand, or every ref
# was a deletion) means lib.sh falls back to its @{u}/merge-base ladder.
ranges=""
while read -r _local_ref local_oid _remote_ref remote_oid; do
  # An all-zero local oid means the ref is being deleted — nothing to check.
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac

  case "$remote_oid" in
    *[!0]*)
      # Ref already exists on the remote: check what this push adds to it.
      ranges="$ranges $remote_oid...$local_oid"
      ;;
    *)
      # Ref is new on the remote: check everything since the default branch.
      base=$(git merge-base "origin/${DEFAULT_BRANCH:-main}" "$local_oid" 2>/dev/null) \
        && ranges="$ranges $base...$local_oid"
      ;;
  esac
done
export PUSH_RANGES="$ranges"

bash scripts/build-frontend.sh
bash scripts/build-backend.sh

echo "──────────── ok ────────────"
