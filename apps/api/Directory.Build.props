<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Test projects are exempt. Conditioned on the project name rather than
       $(IsTestProject), because that property is set inside the .csproj body,
       which MSBuild evaluates after this file is imported. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
